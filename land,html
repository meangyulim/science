<!DOCTYPE html>
<html lang="ko">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no, viewport-fit=cover">
    <title>3D 지사학의 법칙 (모바일 완벽 대응)</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/three.js/r128/three.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/three@0.128.0/examples/js/controls/OrbitControls.js"></script>
    <style>
        body, html { 
            font-family: 'Pretendard', -apple-system, BlinkMacSystemFont, sans-serif; 
            background-color: #f8fafc; margin: 0; padding: 0;
            width: 100%; height: 100%; overflow: hidden; position: fixed; touch-action: none; 
        }
        
        #canvas-container { position: absolute; top: 0; left: 0; width: 100%; height: 100%; z-index: 1; }
        .ui-layer { position: absolute; left: 0; width: 100%; z-index: 10; pointer-events: none; }
        .ui-interactive { pointer-events: auto; }

        .top-bar { top: env(safe-area-inset-top, 10px); padding: 10px 15px; display: flex; justify-content: space-between; align-items: flex-start; }
        .legend-box { background: rgba(255, 255, 255, 0.9); backdrop-filter: blur(5px); border-radius: 10px; padding: 10px; box-shadow: 0 4px 10px rgba(0,0,0,0.05); font-size: 0.7rem; color: #374151; border: 1px solid rgba(200,200,200,0.5); }
        .color-mark { display: inline-block; width: 10px; height: 10px; border-radius: 3px; margin-right: 4px; vertical-align: baseline; }

        .bottom-panel { 
            bottom: 0; background: linear-gradient(to top, rgba(255,255,255,1) 75%, rgba(255,255,255,0)); 
            padding-top: 30px; padding-bottom: env(safe-area-inset-bottom, 15px);
        }

        .desc-box { background: rgba(255, 255, 255, 0.95); border: 1px solid #c7d2fe; border-radius: 12px; margin: 0 15px 10px 15px; padding: 12px; box-shadow: 0 4px 15px rgba(0,0,0,0.05); text-align: center; }
        
        .btn-scroll-container { display: flex; overflow-x: auto; gap: 8px; padding: 5px 15px 15px 15px; scroll-snap-type: x mandatory; }
        .btn-scroll-container::-webkit-scrollbar { display: none; } 
        
        .stage-btn { 
            flex: 0 0 38%; 
            padding: 12px 6px; border-radius: 10px; font-weight: 800; font-size: 0.9rem; 
            scroll-snap-align: center; transition: all 0.2s; border: 2px solid transparent; white-space: nowrap;
        }
        .btn-active { background-color: #4f46e5; color: white; border-color: #3730a3; transform: translateY(-2px); box-shadow: 0 5px 15px rgba(79, 70, 229, 0.3); }
        .btn-inactive { background-color: #ffffff; color: #4b5563; border-color: #e5e7eb; }
    </style>
</head>
<body>

    <div id="canvas-container"></div>

    <div class="ui-layer top-bar">
        <div class="ui-interactive" style="text-shadow: 0 2px 4px rgba(255,255,255,0.9);">
            <h1 class="text-2xl font-extrabold text-indigo-900 tracking-tight leading-none">지사학의 법칙</h1>
            <p class="text-sm font-bold text-indigo-600 mt-1">👆 3D 회전 (드래그)</p>
        </div>
        <div class="ui-interactive legend-box">
            <div class="font-bold border-b border-gray-200 pb-1 mb-1.5 text-center text-gray-800">지층 연령 및 구조</div>
            <div><span class="color-mark" style="background:#fcd34d;"></span>A층 <span class="text-gray-400">|</span> <span class="color-mark" style="background:#9ca3af;"></span>B층</div>
            <div><span class="color-mark" style="background:#6ee7b7;"></span>C층 <span class="text-gray-400">|</span> <span class="color-mark" style="background:#fca5a5;"></span>D층</div>
            <div class="mt-1 pt-1 border-t border-gray-200"><span class="color-mark" style="background:#4b5563;"></span>심성암(난정합)</div>
            <div><span class="color-mark" style="background:#ef4444;"></span>마그마/용암</div>
            <div><span class="color-mark" style="background:#ff7700;"></span>접촉 변성대</div>
        </div>
    </div>

    <!-- 순차적 애니메이션 안내 오버레이 -->
    <div id="seqOverlay" class="absolute top-24 left-1/2 transform -translate-x-1/2 bg-indigo-600/95 text-white px-5 py-2.5 rounded-full font-bold shadow-lg transition-opacity duration-300 opacity-0 z-20 whitespace-nowrap pointer-events-none text-[0.95rem] border border-indigo-400 backdrop-blur-sm">
        1. 융기 중...
    </div>

    <div class="ui-layer bottom-panel ui-interactive">
        <div class="desc-box">
            <p id="descText" class="text-[0.9rem] font-bold text-indigo-900 leading-snug break-keep">
                설명이 여기에 표시됩니다.
            </p>
        </div>

        <div class="relative">
            <!-- 가로 스크롤 버튼들 -->
            <div id="btnContainer" class="btn-scroll-container">
                <button id="btn1" class="stage-btn btn-active" onclick="setStage(1)">1. 수평퇴적</button>
                <button id="btn2" class="stage-btn btn-inactive" onclick="setStage(2)">2. 지층누중</button>
                <button id="btn3" class="stage-btn btn-inactive" onclick="setStage(3)">3-1. 평행부정합</button>
                <button id="btn4" class="stage-btn btn-inactive" onclick="setStage(4)">3-2. 경사부정합</button>
                <button id="btn5" class="stage-btn btn-inactive" onclick="setStage(5)">3-3. 난정합</button>
                <button id="btn6" class="stage-btn btn-inactive" onclick="setStage(6)">4. 동물군천이</button>
                <button id="btn7" class="stage-btn btn-inactive" onclick="setStage(7)">5-1. 관입법칙</button>
                <button id="btn8" class="stage-btn btn-inactive" onclick="setStage(8)">5-2. 분출법칙</button>
            </div>
            <div class="text-center pb-2 text-[0.65rem] text-gray-400 font-medium">좌우로 스와이프 하세요 ↔️</div>
        </div>
    </div>

    <script>
        let currentStage = 1;

        // --- 1. Three.js 환경 설정 ---
        const container = document.getElementById('canvas-container');
        const scene = new THREE.Scene();
        scene.background = new THREE.Color(0xf1f5f9);

        const camera = new THREE.PerspectiveCamera(45, window.innerWidth / window.innerHeight, 0.1, 1000);
        camera.position.set(0, 25, 65); 

        const renderer = new THREE.WebGLRenderer({ antialias: true, alpha: true });
        renderer.setSize(window.innerWidth, window.innerHeight);
        renderer.setPixelRatio(Math.min(window.devicePixelRatio, 2));
        renderer.shadowMap.enabled = true;
        container.appendChild(renderer.domElement);

        const controls = new THREE.OrbitControls(camera, renderer.domElement);
        controls.enableDamping = true; controls.dampingFactor = 0.05;
        controls.target.set(0, -2, 0); controls.maxPolarAngle = Math.PI / 2 + 0.1;
        controls.enablePan = false; 

        const ambientLight = new THREE.AmbientLight(0xffffff, 0.75); scene.add(ambientLight);
        const dirLight = new THREE.DirectionalLight(0xffffff, 0.6);
        dirLight.position.set(20, 50, 40); dirLight.castShadow = true; scene.add(dirLight);

        // --- 2. 동적 지층(Strata) 생성 ---
        const boxW = 50, boxD = 30, segX = 50, segZ = 10;
        function createStratum(yBottom, height, colorHex) {
            const geo = new THREE.BoxGeometry(boxW, height, boxD, segX, 1, segZ).toNonIndexed();
            geo.translate(0, height/2, 0); 
            geo.translate(0, yBottom, 0); 
            const origArray = Float32Array.from(geo.attributes.position.array);
            const mat = new THREE.MeshLambertMaterial({ color: colorHex, side: THREE.FrontSide });
            const mesh = new THREE.Mesh(geo, mat);
            mesh.castShadow = true; mesh.receiveShadow = true;
            scene.add(mesh);
            return { mesh, origArray };
        }

        const layerA = createStratum(-12, 4, 0xfcd34d); 
        const layerB = createStratum(-8, 4, 0x9ca3af);  
        const layerC = createStratum(-4, 4, 0x6ee7b7);  
        const layerD = createStratum(0, 4, 0xfca5a5);   

        // --- 3. 관입암, 심성암, 분출용암, 변성대 생성 ---
        
        // 난정합용 심성암
        const plutonGeo = new THREE.BoxGeometry(50.2, 16, 30.2, 30, 5, 2).toNonIndexed();
        plutonGeo.translate(0, 8, 0); 
        const plutonOrig = Float32Array.from(plutonGeo.attributes.position.array);
        const plutonMat = new THREE.MeshLambertMaterial({ color: 0x4b5563 }); 
        const plutonMesh = new THREE.Mesh(plutonGeo, plutonMat);
        scene.add(plutonMesh);

        // 수직 암맥 (관입/분출 공통)
        const magmaGeo = new THREE.BoxGeometry(6, 25, 8).toNonIndexed();
        magmaGeo.translate(0, 12.5, 0); 
        const magmaOrig = Float32Array.from(magmaGeo.attributes.position.array);
        const magmaMat = new THREE.MeshLambertMaterial({ color: 0xef4444, emissive: 0xef4444, emissiveIntensity: 0.15 });
        const magmaMesh = new THREE.Mesh(magmaGeo, magmaMat);
        magmaMesh.position.set(5, -15, 11.1); 
        magmaMesh.rotation.z = -0.15; 
        scene.add(magmaMesh);

        // [추가] 수평 암상 (지층 사이로 퍼지는 마그마)
        const sillGeo = new THREE.BoxGeometry(26, 2.5, 8).toNonIndexed();
        const sillOrig = Float32Array.from(sillGeo.attributes.position.array);
        const sillMesh = new THREE.Mesh(sillGeo, magmaMat);
        sillMesh.position.set(-6, -8.5, 11.1); // A층과 B층 사이에 퍼짐
        sillMesh.visible = false;
        scene.add(sillMesh);

        // [추가] 접촉 변성대 (Aura) - 뜨거운 마그마 주변이 붉게 변성됨
        const metaMat = new THREE.MeshLambertMaterial({ color: 0xffaa00, transparent: true, opacity: 0, emissive: 0xff4400, emissiveIntensity: 0.6 });
        const metaDikeGeo = new THREE.BoxGeometry(7.5, 25, 9).toNonIndexed();
        metaDikeGeo.translate(0, 12.5, 0);
        const metaDikeOrig = Float32Array.from(metaDikeGeo.attributes.position.array);
        const metaDikeMesh = new THREE.Mesh(metaDikeGeo, metaMat);
        metaDikeMesh.position.copy(magmaMesh.position);
        metaDikeMesh.rotation.z = magmaMesh.rotation.z;
        metaDikeMesh.visible = false;
        scene.add(metaDikeMesh);

        const metaSillGeo = new THREE.BoxGeometry(28, 4, 9).toNonIndexed();
        const metaSillOrig = Float32Array.from(metaSillGeo.attributes.position.array);
        const metaSillMesh = new THREE.Mesh(metaSillGeo, metaMat);
        metaSillMesh.position.copy(sillMesh.position);
        metaSillMesh.visible = false;
        scene.add(metaSillMesh);

        // [추가] 분출 용암 하부 접촉 변성대 (용암대지 밑바닥만 붉게 달굼)
        const metaLavaGeo = new THREE.CylinderGeometry(20.5, 20.5, 1.5, 32).toNonIndexed();
        metaLavaGeo.translate(0, -0.75, 0); // 로컬 Y -1.5 ~ 0 (B층 상단 아래쪽으로 파고듦)
        const metaLavaOrig = Float32Array.from(metaLavaGeo.attributes.position.array);
        const metaLavaMesh = new THREE.Mesh(metaLavaGeo, metaMat);
        metaLavaMesh.position.set(5, -4, 11.1); // B층 상단 높이
        metaLavaMesh.scale.set(0.001, 1, 0.001);
        metaLavaMesh.visible = false;
        scene.add(metaLavaMesh);

        // 분출용 용암대지 (흐르는 용암)
        const lavaGeo = new THREE.CylinderGeometry(20, 20, 1.5, 32).toNonIndexed();
        lavaGeo.translate(0, 0.75, 0); 
        const lavaOrig = Float32Array.from(lavaGeo.attributes.position.array);
        const lavaMat = new THREE.MeshLambertMaterial({ color: 0xef4444, emissive: 0x991b1b, emissiveIntensity: 0.2 });
        const lavaMesh = new THREE.Mesh(lavaGeo, lavaMat);
        lavaMesh.position.set(5, -4, 11.1); 
        lavaMesh.scale.set(0.001, 1, 0.001); 
        lavaMesh.visible = false;
        scene.add(lavaMesh);

        // 화산 폭발 파티클
        const eruptParticles = new THREE.Group();
        eruptParticles.position.set(5, -4, 11.1); 
        for(let i=0; i<30; i++) {
            let p = new THREE.Mesh(new THREE.SphereGeometry(0.3, 4, 4), new THREE.MeshBasicMaterial({color: 0xff5500}));
            p.userData = { vx: (Math.random()-0.5)*0.8, vy: Math.random()*0.8 + 0.6, vz: (Math.random()-0.5)*0.8, age: Math.random() };
            eruptParticles.add(p);
        }
        scene.add(eruptParticles);
        let isErupting = false;

        // 바다 (해수면)
        const seaMesh = new THREE.Mesh(
            new THREE.PlaneGeometry(90, 70),
            new THREE.MeshLambertMaterial({ color: 0x3b82f6, transparent: true, opacity: 0.35, side: THREE.DoubleSide, depthWrite: false })
        );
        seaMesh.rotation.x = -Math.PI / 2;
        scene.add(seaMesh);

        // --- 4. UI 텍스트 & 화석 ---
        function createTextSprite(text, color, scale=10) {
            const cvs = document.createElement('canvas');
            cvs.width = 256; cvs.height = 64;
            const ctx = cvs.getContext('2d');
            ctx.fillStyle = color; ctx.font = 'Bold 42px Pretendard, sans-serif';
            ctx.textAlign = 'center'; ctx.fillText(text, 128, 48);
            const tex = new THREE.CanvasTexture(cvs);
            const mat = new THREE.SpriteMaterial({ map: tex, transparent: true });
            const sprite = new THREE.Sprite(mat);
            sprite.scale.set(scale, scale*0.25, 1); 
            scene.add(sprite); return sprite;
        }
        const lblOld = createTextSprite("가장 오래됨 ⬇️", "#ea580c");
        const lblYoung = createTextSprite("가장 젊음 ⬆️", "#16a34a");

        function createFossil(emoji, x, origY, bg) {
            const cvs = document.createElement('canvas');
            cvs.width = 128; cvs.height = 128;
            const ctx = cvs.getContext('2d');
            ctx.fillStyle = bg; ctx.beginPath(); ctx.arc(64, 64, 55, 0, Math.PI*2); ctx.fill();
            ctx.strokeStyle = '#374151'; ctx.lineWidth=4; ctx.stroke();
            ctx.font = '70px sans-serif'; ctx.textAlign = 'center'; ctx.textBaseline = 'middle';
            ctx.fillText(emoji, 64, 68); 
            const tex = new THREE.CanvasTexture(cvs);
            const sprite = new THREE.Sprite(new THREE.SpriteMaterial({ map: tex }));
            sprite.position.set(x, origY, 15.2); 
            sprite.scale.set(4, 4, 1);
            sprite.userData = { origX: x, origY: origY };
            scene.add(sprite); return sprite;
        }
        const fossils = [
            createFossil("🪲", 10, -10, "#fef3c7"), // 삼엽충(A층)
            createFossil("🐚", 0, -6, "#f3f4f6"),   // 암모나이트(B층)
            createFossil("🦕", -10, -2, "#d1fae5")  // 공룡(C층)
        ];

        // --- 5. 상태 관리 및 수학적 변형(Morphing) ---
        let t_seaY = 4, t_erodeY = 20, t_foldAmp = 0, t_tiltAngle = 0, t_plutonScale = 0;
        let t_magmaHeight = 0, t_sillScale = 0, t_metaOpacity = 0;
        let t_lavaScale = 0, t_lavaColor = 0; 

        let c_seaY = 4, c_erodeY = 20, c_foldAmp = 0, c_tiltAngle = 0, c_plutonScale = 0;
        let c_magmaHeight = 0, c_sillScale = 0, c_metaOpacity = 0;
        let c_lavaScale = 0, c_lavaColor = 0;
        
        const colorLavaHot = new THREE.Color(0xef4444);
        const colorLavaCold = new THREE.Color(0x4b5563);

        function getLayerY(origX, origY) {
            return origY + Math.sin(origX * 0.15) * c_foldAmp + origX * c_tiltAngle;
        }
        function applyErosion(y) { return Math.min(y, c_erodeY); }

        function updateLayerABC(layerObj) {
            if(!layerObj.mesh.visible) return;
            const pos = layerObj.mesh.geometry.attributes.position.array;
            const orig = layerObj.origArray;
            for(let i=0; i<pos.length; i+=3) {
                let newY = getLayerY(orig[i], orig[i+1]);
                pos[i+1] = applyErosion(newY);
            }
            layerObj.mesh.geometry.attributes.position.needsUpdate = true;
            layerObj.mesh.geometry.computeVertexNormals();
        }

        function updateLayerD() {
            if(!layerD.mesh.visible) return;
            const pos = layerD.mesh.geometry.attributes.position.array;
            const orig = layerD.origArray;
            for(let i=0; i<pos.length; i+=3) {
                let x = orig[i];
                let origY = orig[i+1];
                if (origY < 1) { 
                    let baseTopY = 0; 
                    if (currentStage === 5) baseTopY = 0; 
                    if (currentStage === 8) {
                        pos[i+1] = c_erodeY;
                    } else {
                        let topOfUnder = getLayerY(x, baseTopY); 
                        pos[i+1] = applyErosion(topOfUnder);
                    }
                } else {
                    pos[i+1] = c_erodeY + origY;
                }
            }
            layerD.mesh.geometry.attributes.position.needsUpdate = true;
            layerD.mesh.geometry.computeVertexNormals();
        }

        function updatePluton() {
            if(c_plutonScale < 0.01) { plutonMesh.visible = false; return; }
            plutonMesh.visible = true;
            const pos = plutonMesh.geometry.attributes.position.array;
            for(let i=0; i<pos.length; i+=3) {
                let localY = plutonOrig[i+1]; 
                let globalY = -16 + localY * c_plutonScale;
                pos[i+1] = applyErosion(globalY);
            }
            plutonMesh.geometry.attributes.position.needsUpdate = true;
            plutonMesh.geometry.computeVertexNormals();
        }

        function updateMagmaSystem() {
            // 수직 암맥(Dike)
            if(c_magmaHeight < 0.1) { magmaMesh.visible = false; }
            else {
                magmaMesh.visible = true;
                const pos = magmaMesh.geometry.attributes.position.array;
                for(let i=0; i<pos.length; i+=3) {
                    let localY = magmaOrig[i+1]; 
                    let h = (localY / 25) * c_magmaHeight;
                    let globalY = -15 + h; 
                    if (globalY > c_erodeY) globalY = c_erodeY; // 침식 반영
                    pos[i+1] = globalY + 15; 
                }
                magmaMesh.geometry.attributes.position.needsUpdate = true;
                magmaMesh.geometry.computeVertexNormals();
            }

            // 수평 암상(Sill)
            if(c_sillScale < 0.01) { sillMesh.visible = false; }
            else {
                sillMesh.visible = true;
                const pos = sillMesh.geometry.attributes.position.array;
                for(let i=0; i<pos.length; i+=3) {
                    let localX = sillOrig[i];
                    pos[i] = localX * c_sillScale; // X축(좌우)으로 퍼짐
                }
                sillMesh.geometry.attributes.position.needsUpdate = true;
                sillMesh.geometry.computeVertexNormals();
            }

            // 변성대(Metamorphic Aura)
            if(c_metaOpacity < 0.01) { metaDikeMesh.visible = false; metaSillMesh.visible = false; }
            else {
                metaMat.opacity = c_metaOpacity * 0.6; // 최대 투명도 0.6
                
                metaDikeMesh.visible = true;
                const posD = metaDikeMesh.geometry.attributes.position.array;
                for(let i=0; i<posD.length; i+=3) {
                    let localY = metaDikeOrig[i+1]; 
                    let h = (localY / 25) * c_magmaHeight;
                    let globalY = -15 + h; 
                    if (globalY > c_erodeY) globalY = c_erodeY;
                    posD[i+1] = globalY + 15; 
                }
                metaDikeMesh.geometry.attributes.position.needsUpdate = true;

                metaSillMesh.visible = (c_sillScale > 0.01);
                const posS = metaSillMesh.geometry.attributes.position.array;
                for(let i=0; i<posS.length; i+=3) {
                    let localX = metaSillOrig[i];
                    posS[i] = localX * c_sillScale;
                }
                metaSillMesh.geometry.attributes.position.needsUpdate = true;
                
                // [추가] 분출된 용암 하부의 접촉 변성대 (용암과 같이 퍼짐)
                metaLavaMesh.visible = (c_lavaScale > 0.01);
                if (metaLavaMesh.visible) {
                    let s = Math.max(c_lavaScale, 0.001);
                    metaLavaMesh.scale.set(s, 1, s);
                    const posL = metaLavaMesh.geometry.attributes.position.array;
                    for(let i=0; i<posL.length; i+=3) {
                        let localY = metaLavaOrig[i+1];
                        let globalY = -4 + localY;
                        if(globalY > c_erodeY) globalY = c_erodeY;
                        posL[i+1] = globalY - (-4);
                    }
                    metaLavaMesh.geometry.attributes.position.needsUpdate = true;
                }
            }
        }

        function updateLavaLayer() {
            if(c_lavaScale < 0.01) { lavaMesh.visible = false; return; }
            lavaMesh.visible = true;
            let s = Math.max(c_lavaScale, 0.001);
            lavaMesh.scale.set(s, 1, s); 
            
            lavaMat.color.lerpColors(colorLavaHot, colorLavaCold, c_lavaColor);
            lavaMat.emissiveIntensity = 0.2 * (1 - c_lavaColor);

            const pos = lavaMesh.geometry.attributes.position.array;
            for(let i=0; i<pos.length; i+=3) {
                let localY = lavaOrig[i+1];
                let globalY = -4 + localY;
                if(globalY > c_erodeY) globalY = c_erodeY;
                pos[i+1] = globalY - (-4);
            }
            lavaMesh.geometry.attributes.position.needsUpdate = true;
            lavaMesh.geometry.computeVertexNormals();
        }

        function animate() {
            requestAnimationFrame(animate);
            
            c_seaY += (t_seaY - c_seaY) * 0.05;
            c_erodeY += (t_erodeY - c_erodeY) * 0.05;
            c_foldAmp += (t_foldAmp - c_foldAmp) * 0.05;
            c_tiltAngle += (t_tiltAngle - c_tiltAngle) * 0.05;
            c_plutonScale += (t_plutonScale - c_plutonScale) * 0.05;
            
            c_magmaHeight += (t_magmaHeight - c_magmaHeight) * 0.05;
            c_sillScale += (t_sillScale - c_sillScale) * 0.05;
            c_metaOpacity += (t_metaOpacity - c_metaOpacity) * 0.05;

            c_lavaScale += (t_lavaScale - c_lavaScale) * 0.05;
            c_lavaColor += (t_lavaColor - c_lavaColor) * 0.03; 

            updateLayerABC(layerA); updateLayerABC(layerB); updateLayerABC(layerC);
            updateLayerD(); updatePluton(); updateMagmaSystem(); updateLavaLayer();
            
            seaMesh.position.y = c_seaY;

            if (isErupting) {
                eruptParticles.visible = true;
                eruptParticles.children.forEach(p => {
                    p.position.x += p.userData.vx; p.position.y += p.userData.vy; p.position.z += p.userData.vz;
                    p.userData.vy -= 0.03; p.userData.age += 0.02;
                    if(p.userData.age > 1.0 || p.position.y < -4) {
                        p.position.set(0,0,0); p.userData.vy = Math.random()*0.8 + 0.6; p.userData.age = 0;
                    }
                });
            } else { eruptParticles.visible = false; }

            if (lblOld.visible) {
                let refX = -18;
                lblOld.position.set(refX, applyErosion(getLayerY(refX, -10)), 16);
                lblYoung.position.set(refX, applyErosion(getLayerY(refX, -2)), 16);
            }
            if (fossils[0].visible) {
                fossils.forEach(f => {
                    f.position.y = applyErosion(getLayerY(f.userData.origX, f.userData.origY));
                });
            }

            controls.update();
            renderer.render(scene, camera);
        }

        window.addEventListener('resize', () => {
            const width = window.innerWidth; const height = window.innerHeight;
            camera.aspect = width / height; camera.fov = width < height ? 60 : 45;
            camera.updateProjectionMatrix(); renderer.setSize(width, height);
        });
        window.dispatchEvent(new Event('resize'));

        // --- 6. 시퀀스 애니메이션 제어 ---
        let seqTimers = [];
        function clearSeq() {
            seqTimers.forEach(clearTimeout); seqTimers = [];
            const el = document.getElementById('seqOverlay');
            el.classList.replace('opacity-100', 'opacity-0');
        }
        function addSeq(delay, text, func) {
            seqTimers.push(setTimeout(() => {
                if(text) {
                    const el = document.getElementById('seqOverlay');
                    el.innerText = text;
                    el.classList.replace('opacity-0', 'opacity-100');
                }
                if(func) func();
            }, delay));
        }

        function jumpToFlat() {
            clearSeq();
            c_seaY = t_seaY = 4; c_erodeY = t_erodeY = 20; 
            c_foldAmp = t_foldAmp = 0; c_tiltAngle = t_tiltAngle = 0;
            c_plutonScale = t_plutonScale = 0;
            
            c_magmaHeight = t_magmaHeight = 0; 
            c_sillScale = t_sillScale = 0; 
            c_metaOpacity = t_metaOpacity = 0;

            c_lavaScale = t_lavaScale = 0; c_lavaColor = t_lavaColor = 0; isErupting = false;
            
            layerD.mesh.visible = false; magmaMesh.visible = false; sillMesh.visible = false; 
            metaDikeMesh.visible = false; metaSillMesh.visible = false; metaLavaMesh.visible = false; lavaMesh.visible = false;
            
            lblOld.visible = false; lblYoung.visible = false;
            fossils.forEach(f => f.visible = false);
            layerA.mesh.visible = true; layerB.mesh.visible = true; layerC.mesh.visible = true;
            
            lavaMat.color.copy(colorLavaHot); lavaMat.emissiveIntensity = 0.2;
        }

        const descriptions = [
            "[수평 퇴적의 법칙] 물 밑에 퇴적물이 쌓일 때는 중력에 의해 지표면과 나란하게 '수평'으로 쌓입니다.",
            "[지층 누중의 법칙] 역전되지 않았다면, 아래에 있는 지층일수록 먼저 쌓인 '오래된' 암석입니다.",
            "[평행 부정합] 융기되어 절반쯤 깎여나간 후, 다시 가라앉아 새로운 지층(D)이 평행하게 쌓였습니다.",
            "[경사 부정합] 지각변동으로 구불구불해진 지층이 융기해 깎인 후, 푹 파인 계곡까지 완벽하게 새 지층이 메우며 퇴적됩니다.",
            "[난정합] 아래에 거대한 심성암이 있고, 깎인 후 그 위에 퇴적암이 쌓인 구조입니다.",
            "[동물군 천이] 아래에서 위 지층으로 갈수록 더 진화되고 복잡한 생물(삼엽충➡️암모나이트➡️공룡)의 화석이 발견됩니다.",
            "[관입의 법칙] 마그마가 지층 내부로 파고들며 주변에 '접촉 변성대'가 생깁니다. 관입암은 뚫린 지층보다 나중입니다.",
            "[분출의 법칙] 마그마가 지표로 터져 나와 흐릅니다. 닿아있는 아래 지층(B)만 변성되고, 나중에 덮인 위 지층(D)은 변성되지 않습니다!"
        ];

        window.setStage = function(stage) {
            currentStage = stage;
            const container = document.getElementById('btnContainer');
            for (let i = 1; i <= 8; i++) {
                const btn = document.getElementById(`btn${i}`);
                if (i === stage) {
                    btn.classList.replace('btn-inactive', 'btn-active');
                    container.scrollTo({ left: btn.offsetLeft - (container.clientWidth/2) + (btn.clientWidth/2), behavior: 'smooth' });
                } else {
                    btn.classList.replace('btn-active', 'btn-inactive');
                }
            }
            document.getElementById('descText').innerText = descriptions[stage - 1];
            jumpToFlat(); 

            if (stage === 1) { } 
            else if (stage === 2) {
                lblOld.visible = true; lblYoung.visible = true;
            } 
            else if (stage === 3) {
                addSeq(500, "1. 해수면 아래 수평 퇴적", () => {});
                addSeq(2000, "2. 융기 (지층이 바다 위로 상승)", () => { t_seaY = -12; });
                addSeq(4000, "3. 침식 (절반 정도만 평행하게 깎임)", () => { t_erodeY = -2; }); 
                addSeq(6000, "4. 침강 (다시 바다 밑으로 가라앉음)", () => { t_seaY = 2; });
                addSeq(8000, "5. 부정합면 위 새로운 지층(D) 퇴적", () => { layerD.mesh.visible = true; });
                addSeq(10000, "", () => { clearSeq(); }); 
            }
            else if (stage === 4) {
                addSeq(500, "1. 해수면 아래 수평 퇴적", () => {});
                addSeq(2000, "2. 지각 변동 (습곡 및 경사) + 융기", () => { t_seaY = -12; t_foldAmp = 4; t_tiltAngle = 0.15; });
                addSeq(4500, "3. 침식 (향사/골짜기를 남기고 깎임)", () => { t_erodeY = -5; }); 
                addSeq(6500, "4. 침강 (다시 물 속으로)", () => { t_seaY = 2; });
                addSeq(8500, "5. 깎인 골짜기(빈공간)를 완벽히 채우며 수평 퇴적", () => { layerD.mesh.visible = true; });
                addSeq(10500, "", () => { clearSeq(); });
            }
            else if (stage === 5) {
                addSeq(500, "1. 해수면 아래 퇴적 지층", () => {});
                addSeq(2000, "2. 심성암 대규모 관입 및 융기", () => { t_seaY = -12; t_plutonScale = 1; });
                addSeq(4500, "3. 침식 (심성암 윗부분까지 깎임)", () => { t_erodeY = -2; });
                addSeq(6500, "4. 침강 (다시 물 속으로)", () => { t_seaY = 2; });
                addSeq(8500, "5. 심성암 위에 새 지층(D) 퇴적", () => { layerD.mesh.visible = true; });
                addSeq(10500, "", () => { clearSeq(); });
            }
            else if (stage === 6) {
                fossils.forEach(f => f.visible = true);
                addSeq(500, "아래(과거)일수록 원시적인 삼엽충(🪲)", () => {});
                addSeq(3000, "위(최근)일수록 진화된 공룡(🦕)", () => {});
                addSeq(6000, "", () => { clearSeq(); });
            }
            else if (stage === 7) {
                // [관입 완벽 구현] 수직 암맥 + 수평 암상 + 접촉 변성대
                addSeq(500, "1. A, B, C 지층 수평 퇴적", () => {});
                addSeq(2000, "2. 마그마 수직 관입 (지표면 아래에서 멈춤)", () => { t_magmaHeight = 14; }); 
                addSeq(4000, "3. 지층 틈새로 마그마 확산(수평 암상) 및 접촉 변성대 형성!", () => { t_sillScale = 1; t_metaOpacity = 1; }); 
                addSeq(7000, "4. 융기 및 침식 (마그마와 변성대도 함께 평평하게 깎임)", () => { t_seaY = -12; t_erodeY = -2.5; }); 
                addSeq(9500, "5. 침강 및 새 지층(D) 덮임", () => { t_seaY = 2; layerD.mesh.visible = true; });
                addSeq(12500, "결론: D층엔 변성 작용이 없으니 마그마보다 나중에 쌓였다!", () => { clearSeq(); });
            }
            else if (stage === 8) {
                layerC.mesh.visible = false; 
                addSeq(500, "1. A, B 지층 수평 퇴적", () => {});
                addSeq(2000, "2. 마그마 상승 및 지표면(B층) 도달 (변성 작용 시작)", () => { t_magmaHeight = 11; t_metaOpacity = 1; }); 
                addSeq(3500, "3. 펑! 마그마 지표 분출 및 용암 확산", () => { isErupting = true; t_lavaScale = 1; }); 
                addSeq(6500, "4. 분출 종료 및 용암 냉각(화성암)", () => { isErupting = false; t_lavaColor = 1; }); 
                addSeq(8500, "5. 융기 및 침식 (용암대지가 깎임)", () => { t_seaY = -12; t_erodeY = -3.5; }); 
                addSeq(10500, "6. 침강 및 새 지층(D) 덮임", () => { t_seaY = 2; layerD.mesh.visible = true; });
                addSeq(13000, "결론: D층은 변성 안 됨 = 용암 분출 후 쌓였다!", () => { clearSeq(); });
            }
        };

        setStage(1);
        animate();
    </script>
</body>
</html>
