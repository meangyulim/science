{
  "rules": {
    "quake": {
      "rooms": {
        "$code": {
          ".read": "auth != null && data.child('meta/teacher').val() === auth.uid",
          ".write": "auth != null && data.child('meta/teacher').val() === auth.uid",
          "meta": {
            ".read": "auth != null",
            ".write": "auth != null && (!data.exists() || data.child('teacher').val() === auth.uid)",
            ".validate": "newData.child('teacher').val() === auth.uid || !newData.exists()"
          },
          "players": {
            ".read": "auth != null",
            "$uid": {
              ".write": "auth != null && auth.uid === $uid && root.child('quake/rooms/' + $code + '/meta').exists()",
              "name": { ".validate": "newData.isString() && newData.val().length <= 20" }
            }
          },
          "arr": {
            "$uid": { ".read": "auth != null && auth.uid === $uid" }
          },
          "picks": {
            ".read": "auth != null",
            "$uid": { ".write": "auth != null && auth.uid === $uid && root.child('quake/rooms/' + $code + '/meta').exists()" }
          },
          "guesses": {
            ".read": "auth != null",
            "$team": { ".write": "auth != null && root.child('quake/rooms/' + $code + '/meta').exists()" }
          },
          "reveal": { ".read": "auth != null" },
          "chat": {
            "$tk": {
              ".read": "auth != null && root.child('quake/rooms/' + $code + '/players/' + auth.uid + '/tk').val() === $tk",
              "$msg": {
                ".write": "auth != null && !data.exists() && root.child('quake/rooms/' + $code + '/players/' + auth.uid + '/tk').val() === $tk",
                ".validate": "newData.hasChildren(['uid', 'name', 'text', 't']) && newData.child('uid').val() === auth.uid && newData.child('text').isString() && newData.child('text').val().length <= 120"
              }
            }
          }
        }
      }
    }
  }
}
