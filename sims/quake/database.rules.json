{
  "rules": {
    "seats": {
      "boards": {
        "$bid": {
          ".read": "auth != null && $bid.length >= 16",
          ".write": "auth != null && $bid.length >= 16",
          "info": {
            ".validate": "newData.hasChildren(['cls', 't']) && newData.child('cls').isString() && newData.child('cls').val().length <= 20 && (!newData.child('text').exists() || (newData.child('text').isString() && newData.child('text').val().length <= 4000))"
          },
          "hist": {
            "$h": { ".validate": "newData.hasChildren(['t', 'seats', 'layout']) && newData.child('t').isNumber()" }
          },
          "$other": { ".validate": false }
        }
      },
      "rooms": {
        "$code": {
          ".read": "auth != null && data.child('meta/teacher').val() === auth.uid",
          ".write": "auth != null && data.child('meta/teacher').val() === auth.uid",
          "meta": {
            ".read": "auth != null",
            ".write": "auth != null && (!data.exists() || data.child('teacher').val() === auth.uid)",
            ".validate": "newData.child('teacher').val() === auth.uid || !newData.exists()"
          },
          "roster": { ".read": "auth != null" },
          "result": { ".read": "auth != null" },
          "claims": {
            ".read": "auth != null",
            "$k": {
              ".write": "auth != null && root.child('seats/rooms/' + $code + '/meta/phase').val() === 'open' && root.child('seats/rooms/' + $code + '/roster/' + $k).exists() && (!data.exists() || data.val() === auth.uid) && (!newData.exists() || newData.val() === auth.uid)",
              ".validate": "newData.isString()"
            }
          },
          "joins": {
            "$uid": {
              ".read": "auth != null && auth.uid === $uid",
              ".write": "auth != null && auth.uid === $uid && root.child('seats/rooms/' + $code + '/meta/phase').val() === 'open'",
              ".validate": "newData.hasChildren(['name', 't']) && newData.child('name').isString() && newData.child('name').val().length >= 1 && newData.child('name').val().length <= 20",
              "name": { ".validate": "newData.isString()" },
              "no": { ".validate": "newData.isNumber()" },
              "t": { ".validate": "newData.isNumber()" },
              "$other": { ".validate": false }
            }
          },
          "prefs": {
            "$uid": {
              ".read": "auth != null && auth.uid === $uid",
              ".write": "auth != null && auth.uid === $uid && root.child('seats/rooms/' + $code + '/meta/phase').val() === 'open'",
              ".validate": "newData.hasChildren(['who', 't']) && newData.child('who').isString() && root.child('seats/rooms/' + $code + '/claims/' + newData.child('who').val()).val() === $uid",
              "who": { ".validate": "newData.isString()" },
              "f": { ".validate": "newData.isString() && newData.val().length <= 40" },
              "w": { ".validate": "newData.isString() && newData.val().length <= 40" },
              "t": { ".validate": "newData.isNumber()" },
              "$other": { ".validate": false }
            }
          }
        }
      }
    },
    "quake": {
      "rooms": {
        "$code": {
          ".read": "auth != null && data.child('meta/teacher').val() === auth.uid",
          ".write": "auth != null && data.child('meta/teacher').val() === auth.uid",
          "meta": {
            ".read": "auth != null",
            ".write": "auth != null && (!data.exists() || data.child('teacher').val() === auth.uid)",
            ".validate": "newData.child('teacher').val() === auth.uid || !newData.exists()"
          },
          "players": {
            ".read": "auth != null",
            "$uid": {
              ".write": "auth != null && auth.uid === $uid && root.child('quake/rooms/' + $code + '/meta').exists()",
              "name": { ".validate": "newData.isString() && newData.val().length <= 20" }
            }
          },
          "arr": {
            "$uid": { ".read": "auth != null && auth.uid === $uid" }
          },
          "picks": {
            ".read": "auth != null",
            "$uid": { ".write": "auth != null && auth.uid === $uid && root.child('quake/rooms/' + $code + '/meta').exists()" }
          },
          "guesses": {
            ".read": "auth != null",
            "$team": { ".write": "auth != null && root.child('quake/rooms/' + $code + '/meta').exists()" }
          },
          "reveal": { ".read": "auth != null" },
          "chat": {
            "$tk": {
              ".read": "auth != null && root.child('quake/rooms/' + $code + '/players/' + auth.uid + '/tk').val() === $tk",
              "$msg": {
                ".write": "auth != null && !data.exists() && root.child('quake/rooms/' + $code + '/players/' + auth.uid + '/tk').val() === $tk",
                ".validate": "newData.hasChildren(['uid', 'name', 'text', 't']) && newData.child('uid').val() === auth.uid && newData.child('text').isString() && newData.child('text').val().length <= 120"
              }
            }
          }
        }
      }
    }
  }
}
